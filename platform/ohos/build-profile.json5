{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "targetSdkVersion": "5.1.1(19)",
        "compatibleSdkVersion": "5.1.1(19)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ]
  },
  "modules": [
    {
      "name": "huxerui",
      "srcPath": "./huxerui",
      "targets": [{ "name": "default", "applyToProducts": ["default"] }]
    },
    {
      "name": "example_runner",
      "srcPath": "./example_runner",
      "targets": [{ "name": "default", "applyToProducts": ["default"] }]
    }
  ]
}
