@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/HuxerUIApp.cmake")

if (HUXERUI_LIBRARY_GRAPH_ONLY)
    _huxerui_configure_library_graph_framework()
    set(HuxerUI_shared_FOUND TRUE)
    set(HuxerUI_static_FOUND TRUE)
    check_required_components(HuxerUI)
    return()
endif ()

set(HUXERUI_HOST_TOOL_ROOT "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/huxerui/tools")
set_and_check(HUXERUI_BUILTIN_RESOURCE_PACKAGE
        "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/huxerui/resources"
)
if (HUXERUI_ENABLE_LTO OR NOT HUXERUI_OPTIMIZATION STREQUAL "default")
    message(STATUS "HuxerUI SDK libraries are prebuilt; optimization overrides apply to source targets")
endif ()

set(_HUXERUI_WANT_SHARED FALSE)
set(_HUXERUI_WANT_STATIC FALSE)
if (HuxerUI_FIND_COMPONENTS)
    foreach (_HUXERUI_COMPONENT IN LISTS HuxerUI_FIND_COMPONENTS)
        if (_HUXERUI_COMPONENT STREQUAL "shared")
            set(_HUXERUI_WANT_SHARED TRUE)
        elseif (_HUXERUI_COMPONENT STREQUAL "static")
            set(_HUXERUI_WANT_STATIC TRUE)
        endif ()
    endforeach ()
    if ("testing" IN_LIST HuxerUI_FIND_COMPONENTS AND NOT _HUXERUI_WANT_STATIC AND NOT _HUXERUI_WANT_SHARED)
        if (ANDROID OR EMSCRIPTEN OR IOS OR @HUXERUI_BUILD_STATIC@)
            set(_HUXERUI_WANT_STATIC TRUE)
        else ()
            set(_HUXERUI_WANT_SHARED TRUE)
        endif ()
    endif ()
elseif (ANDROID OR EMSCRIPTEN OR IOS)
    set(_HUXERUI_WANT_STATIC TRUE)
else ()
    set(_HUXERUI_WANT_SHARED @HUXERUI_BUILD_SHARED@)
    set(_HUXERUI_WANT_STATIC @HUXERUI_BUILD_STATIC@)
endif ()

if (IOS)
    if (_HUXERUI_WANT_STATIC)
        set_and_check(_HUXERUI_IOS_XCFRAMEWORK
                "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/huxerui/platform/ios/HuxerUI.xcframework"
        )
        string(TOLOWER "${CMAKE_OSX_SYSROOT}" _HUXERUI_IOS_SYSROOT)
        if (_HUXERUI_IOS_SYSROOT MATCHES "simulator")
            set(_HUXERUI_IOS_SLICE "ios-arm64_x86_64-simulator")
        else ()
            set(_HUXERUI_IOS_SLICE "ios-arm64")
        endif ()
        set_and_check(_HUXERUI_IOS_LIBRARY
                "${_HUXERUI_IOS_XCFRAMEWORK}/${_HUXERUI_IOS_SLICE}/libhuxerui_static.a"
        )
        set(_HUXERUI_IOS_LINK_LIBRARIES
                "-framework AVFoundation"
                "-framework Contacts"
                "-framework CoreBluetooth"
                "-framework CoreFoundation"
                "-framework CoreGraphics"
                "-framework CoreImage"
                "-framework CoreLocation"
                "-framework CoreText"
                "-framework CoreVideo"
                "-framework EventKit"
                "-framework Foundation"
                "-framework ImageIO"
                "-framework Metal"
                "-framework MetalPerformanceShaders"
                "-framework MobileCoreServices"
                "-framework Photos"
                "-framework QuartzCore"
                "-framework UIKit"
                "-framework UserNotifications"
                "-weak_framework UniformTypeIdentifiers"
        )
        foreach (_HUXERUI_IOS_TARGET IN ITEMS HuxerUI::huxerui HuxerUI::huxerui_static)
            if (TARGET ${_HUXERUI_IOS_TARGET})
                continue()
            endif ()
            add_library(${_HUXERUI_IOS_TARGET} STATIC IMPORTED)
            set_target_properties(${_HUXERUI_IOS_TARGET} PROPERTIES
                    IMPORTED_LOCATION "${_HUXERUI_IOS_LIBRARY}"
                    INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
                    INTERFACE_LINK_LIBRARIES "${_HUXERUI_IOS_LINK_LIBRARIES}"
            )
        endforeach ()
    endif ()
elseif (ANDROID)
    if (NOT ANDROID_ABI)
        message(FATAL_ERROR "HuxerUI Android package requires ANDROID_ABI")
    endif ()
    if (_HUXERUI_WANT_STATIC)
        set_and_check(HUXERUI_ANDROID_STATIC_LIBRARY
                "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/huxerui/platform/android/${ANDROID_ABI}/libhuxerui_static.a"
        )
        foreach (_HUXERUI_ANDROID_TARGET IN ITEMS HuxerUI::huxerui HuxerUI::huxerui_static)
            if (TARGET ${_HUXERUI_ANDROID_TARGET})
                continue()
            endif ()
            add_library(${_HUXERUI_ANDROID_TARGET} STATIC IMPORTED)
            set_target_properties(${_HUXERUI_ANDROID_TARGET} PROPERTIES
                    IMPORTED_LOCATION "${HUXERUI_ANDROID_STATIC_LIBRARY}"
                    INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
                    INTERFACE_LINK_LIBRARIES "android;EGL;GLESv2;log"
            )
            _huxerui_configure_android_static_target(${_HUXERUI_ANDROID_TARGET})
        endforeach ()
    endif ()
elseif (EMSCRIPTEN)
    if (_HUXERUI_WANT_STATIC)
        set_and_check(HUXERUI_WEB_LIBRARY
                "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/huxerui/platform/web/emscripten-@HUXERUI_WEB_EMSCRIPTEN_VERSION@/libhuxerui.a"
        )
        foreach (_HUXERUI_WEB_TARGET IN ITEMS HuxerUI::huxerui HuxerUI::huxerui_static)
            if (TARGET ${_HUXERUI_WEB_TARGET})
                continue()
            endif ()
            add_library(${_HUXERUI_WEB_TARGET} STATIC IMPORTED)
            set_target_properties(${_HUXERUI_WEB_TARGET} PROPERTIES
                    IMPORTED_LOCATION "${HUXERUI_WEB_LIBRARY}"
                    INTERFACE_COMPILE_OPTIONS -fexceptions
                    INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
                    INTERFACE_LINK_OPTIONS
                    "--bind;--no-entry;SHELL:--pre-js \"${CMAKE_CURRENT_LIST_DIR}/HuxerUIWebPlatformRegistry.js\";SHELL:--pre-js \"${CMAKE_CURRENT_LIST_DIR}/HuxerUIWebFileSystem.js\";-fexceptions;-lidbfs.js;-sMODULARIZE=1;-sEXPORT_ES6=1;-sEXPORT_NAME=createHuxerUIApp;-sEXPORTED_RUNTIME_METHODS=stringToNewUTF8;-sENVIRONMENT=web;-sALLOW_MEMORY_GROWTH=1;-sSTACK_SIZE=1048576;-sNO_EXIT_RUNTIME=1"
                    INTERFACE_LINK_DEPENDS
                    "${CMAKE_CURRENT_LIST_DIR}/HuxerUIWebPlatformRegistry.js;${CMAKE_CURRENT_LIST_DIR}/HuxerUIWebFileSystem.js"
            )
        endforeach ()
    endif ()
else ()
    if (CMAKE_SIZEOF_VOID_P AND NOT CMAKE_SIZEOF_VOID_P STREQUAL "@CMAKE_SIZEOF_VOID_P@")
        message(FATAL_ERROR
                "HuxerUI SDK host libraries use a @CMAKE_SIZEOF_VOID_P@-byte pointer model, "
                "but the consuming target uses ${CMAKE_SIZEOF_VOID_P} bytes"
        )
    endif ()
    if (_HUXERUI_WANT_SHARED AND @HUXERUI_BUILD_SHARED@ AND NOT TARGET HuxerUI::huxerui)
        include("${CMAKE_CURRENT_LIST_DIR}/HuxerUISharedTargets.cmake")
    endif ()
    if (_HUXERUI_WANT_STATIC AND @HUXERUI_BUILD_STATIC@ AND NOT TARGET HuxerUI::huxerui_static)
        if (CMAKE_SYSTEM_NAME STREQUAL "Linux")
            include("${CMAKE_CURRENT_LIST_DIR}/HuxerUILinuxStaticDependencies.cmake")
        endif ()
        include("${CMAKE_CURRENT_LIST_DIR}/HuxerUIStaticTargets.cmake")
    endif ()
endif ()

foreach (_HUXERUI_TARGET IN ITEMS HuxerUI::huxerui HuxerUI::huxerui_static)
    if (TARGET ${_HUXERUI_TARGET})
        set_target_properties(${_HUXERUI_TARGET} PROPERTIES
                HUXERUI_RESOURCE_PACKAGE "${HUXERUI_BUILTIN_RESOURCE_PACKAGE}"
        )
    endif ()
endforeach ()

if ("testing" IN_LIST HuxerUI_FIND_COMPONENTS)
    if ("static" IN_LIST HuxerUI_FIND_COMPONENTS AND "shared" IN_LIST HuxerUI_FIND_COMPONENTS)
        message(FATAL_ERROR "HuxerUI testing requires a single core link form")
    endif ()
    if (_HUXERUI_WANT_STATIC)
        set(_HUXERUI_TESTING_CORE_TARGET HuxerUI::huxerui_static)
    else ()
        set(_HUXERUI_TESTING_CORE_TARGET HuxerUI::huxerui)
    endif ()
    if (TARGET HuxerUI::testing)
        get_target_property(_HUXERUI_TESTING_BOUND_CORE HuxerUI::testing INTERFACE_LINK_LIBRARIES)
        if (_HUXERUI_TESTING_BOUND_CORE)
            if (NOT "static" IN_LIST HuxerUI_FIND_COMPONENTS AND NOT "shared" IN_LIST HuxerUI_FIND_COMPONENTS)
                set(_HUXERUI_TESTING_CORE_TARGET "${_HUXERUI_TESTING_BOUND_CORE}")
            elseif (NOT _HUXERUI_TESTING_BOUND_CORE STREQUAL _HUXERUI_TESTING_CORE_TARGET)
                message(FATAL_ERROR "HuxerUI testing is already bound to ${_HUXERUI_TESTING_BOUND_CORE}")
            endif ()
        endif ()
    endif ()
    set(HuxerUI_testing_FOUND FALSE)
    set(_HUXERUI_TESTING_TYPE STATIC)
    set(_HUXERUI_TESTING_LIBRARY "")
    if (ANDROID)
        set(_HUXERUI_TESTING_LIBRARY "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/huxerui/platform/android/${ANDROID_ABI}/libhuxerui_testing.a")
    elseif (IOS)
        set(_HUXERUI_TESTING_LIBRARY "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/huxerui/platform/ios/HuxerUITesting.xcframework/${_HUXERUI_IOS_SLICE}/libhuxerui_testing.a")
    elseif (EMSCRIPTEN)
        set(_HUXERUI_TESTING_LIBRARY "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/huxerui/platform/web/emscripten-@HUXERUI_WEB_EMSCRIPTEN_VERSION@/libhuxerui_testing.a")
    elseif (EXISTS "${CMAKE_CURRENT_LIST_DIR}/HuxerUITestingTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/HuxerUITestingTargets.cmake")
    endif ()
    if (_HUXERUI_TESTING_LIBRARY AND EXISTS "${_HUXERUI_TESTING_LIBRARY}" AND NOT TARGET HuxerUI::testing)
        add_library(HuxerUI::testing ${_HUXERUI_TESTING_TYPE} IMPORTED)
        set_target_properties(HuxerUI::testing PROPERTIES
                IMPORTED_LOCATION "${_HUXERUI_TESTING_LIBRARY}"
                INTERFACE_COMPILE_FEATURES cxx_std_20
        )
    endif ()
    if (TARGET HuxerUI::testing)
        if (TARGET ${_HUXERUI_TESTING_CORE_TARGET})
            set_target_properties(HuxerUI::testing PROPERTIES
                    INTERFACE_LINK_LIBRARIES "${_HUXERUI_TESTING_CORE_TARGET}"
            )
            set(HuxerUI_testing_FOUND TRUE)
        endif ()
    endif ()
    unset(_HUXERUI_TESTING_CORE_TARGET)
    unset(_HUXERUI_TESTING_BOUND_CORE)
    unset(_HUXERUI_TESTING_TYPE)
    unset(_HUXERUI_TESTING_LIBRARY)
endif ()

foreach (_HUXERUI_COMPONENT IN LISTS HuxerUI_FIND_COMPONENTS)
    if (_HUXERUI_COMPONENT STREQUAL "shared" AND TARGET HuxerUI::huxerui)
        get_target_property(_HUXERUI_CORE_TYPE HuxerUI::huxerui TYPE)
        if (_HUXERUI_CORE_TYPE STREQUAL "SHARED_LIBRARY")
            set(HuxerUI_shared_FOUND TRUE)
        else ()
            set(HuxerUI_shared_FOUND FALSE)
        endif ()
    elseif (_HUXERUI_COMPONENT STREQUAL "static" AND TARGET HuxerUI::huxerui_static)
        set(HuxerUI_static_FOUND TRUE)
    endif ()
endforeach ()

include("${CMAKE_CURRENT_LIST_DIR}/HuxerUIWindowsInstaller.cmake")

check_required_components(HuxerUI)

unset(_HUXERUI_COMPONENT)
unset(_HUXERUI_ANDROID_TARGET)
unset(_HUXERUI_CORE_TYPE)
unset(_HUXERUI_IOS_LIBRARY)
unset(_HUXERUI_IOS_LINK_LIBRARIES)
unset(_HUXERUI_IOS_SLICE)
unset(_HUXERUI_IOS_SYSROOT)
unset(_HUXERUI_IOS_TARGET)
unset(_HUXERUI_IOS_XCFRAMEWORK)
unset(_HUXERUI_TARGET)
unset(_HUXERUI_WANT_SHARED)
unset(_HUXERUI_WANT_STATIC)
unset(_HUXERUI_WEB_TARGET)
