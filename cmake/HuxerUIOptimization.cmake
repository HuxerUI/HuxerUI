include_guard(GLOBAL)

set(HUXERUI_OPTIMIZATION default CACHE STRING "HuxerUI release optimization: default, size, or minsize")
set_property(CACHE HUXERUI_OPTIMIZATION PROPERTY STRINGS default size minsize)
option(HUXERUI_ENABLE_LTO "Enable LTO for HuxerUI source targets in release configurations" OFF)
if (NOT HUXERUI_OPTIMIZATION MATCHES "^(default|size|minsize)$")
    message(FATAL_ERROR "HuxerUI optimization must be default, size, or minsize")
endif ()

function(_huxerui_configure_optimization target_name)
    if (HUXERUI_LIBRARY_GRAPH_ONLY)
        return()
    endif ()
    get_property(reported GLOBAL PROPERTY _HUXERUI_OPTIMIZATION_REPORTED)
    if (NOT reported)
        message(STATUS "HuxerUI release optimization: ${HUXERUI_OPTIMIZATION}; LTO: ${HUXERUI_ENABLE_LTO}")
        set_property(GLOBAL PROPERTY _HUXERUI_OPTIMIZATION_REPORTED TRUE)
    endif ()
    set(release "$<CONFIG:Release,RelWithDebInfo,MinSizeRel>")
    set(compile_release "$<AND:${release},$<COMPILE_LANGUAGE:C,CXX,OBJC,OBJCXX>>")
    set(size_option)
    if (HUXERUI_OPTIMIZATION STREQUAL "size")
        if (MSVC)
            set(size_option /O1)
        else ()
            set(size_option -Os)
        endif ()
    elseif (HUXERUI_OPTIMIZATION STREQUAL "minsize")
        include(CheckCXXCompilerFlag)
        check_cxx_compiler_flag("-Oz" _HUXERUI_HAS_OZ)
        if (NOT _HUXERUI_HAS_OZ)
            message(FATAL_ERROR "HuxerUI minsize optimization requires compiler support for -Oz")
        endif ()
        set(size_option -Oz)
    endif ()
    if (size_option)
        target_compile_options(${target_name} PRIVATE "$<${compile_release}:${size_option}>")
    endif ()

    if (HUXERUI_ENABLE_LTO AND ANDROID)
        # Older CMake IPO checks lose NDK settings and may select the removed gold linker.
        include(CMakePushCheckState)
        include(CheckCXXCompilerFlag)
        cmake_push_check_state(RESET)
        set(CMAKE_REQUIRED_LINK_OPTIONS -flto=thin)
        check_cxx_compiler_flag("-flto=thin" _HUXERUI_HAS_THIN_LTO)
        cmake_pop_check_state()
        if (NOT _HUXERUI_HAS_THIN_LTO)
            message(FATAL_ERROR "HuxerUI LTO requires NDK support for -flto=thin")
        endif ()
        target_compile_options(${target_name} PRIVATE "$<${compile_release}:-flto=thin>")
        target_link_options(${target_name} PRIVATE "$<${release}:-flto=thin>")
    elseif (HUXERUI_ENABLE_LTO)
        get_property(ipo_checked GLOBAL PROPERTY _HUXERUI_IPO_CHECKED)
        if (NOT ipo_checked)
            include(CheckIPOSupported)
            check_ipo_supported(RESULT ipo_supported OUTPUT ipo_error LANGUAGES CXX)
            if (NOT ipo_supported)
                message(FATAL_ERROR "HuxerUI LTO is unavailable: ${ipo_error}")
            endif ()
            set_property(GLOBAL PROPERTY _HUXERUI_IPO_CHECKED TRUE)
        endif ()
        foreach (configuration IN ITEMS RELEASE RELWITHDEBINFO MINSIZEREL)
            set_property(TARGET ${target_name} PROPERTY INTERPROCEDURAL_OPTIMIZATION_${configuration} TRUE)
        endforeach ()
    endif ()

    if (MSVC)
        target_compile_options(${target_name} PRIVATE "$<${compile_release}:/Gy;/Gw>")
    elseif (NOT APPLE AND NOT EMSCRIPTEN)
        target_compile_options(${target_name} PRIVATE "$<${compile_release}:-ffunction-sections;-fdata-sections>")
        if (CMAKE_CXX_COMPILER_ID MATCHES "Clang")
            include(CheckCXXCompilerFlag)
            check_cxx_compiler_flag("-faddrsig" _HUXERUI_HAS_ADDRSIG)
            if (_HUXERUI_HAS_ADDRSIG)
                target_compile_options(${target_name} PRIVATE "$<${compile_release}:-faddrsig>")
            endif ()
        endif ()
    endif ()

    get_target_property(target_type ${target_name} TYPE)
    if (target_type STREQUAL "STATIC_LIBRARY" OR target_type STREQUAL "OBJECT_LIBRARY")
        return()
    endif ()
    include(CheckLinkerFlag)
    if (MSVC)
        target_link_options(${target_name} PRIVATE "$<${release}:LINKER:/OPT:REF>")
    elseif (APPLE)
        target_link_options(${target_name} PRIVATE "$<${release}:LINKER:-dead_strip>")
    else ()
        check_linker_flag(CXX "LINKER:--gc-sections" _HUXERUI_HAS_GC_SECTIONS)
        if (_HUXERUI_HAS_GC_SECTIONS)
            target_link_options(${target_name} PRIVATE "$<${release}:LINKER:--gc-sections>")
        endif ()
        if (_HUXERUI_HAS_ADDRSIG)
            check_linker_flag(CXX "LINKER:--icf=safe" _HUXERUI_HAS_SAFE_ICF)
            if (_HUXERUI_HAS_SAFE_ICF)
                target_link_options(${target_name} PRIVATE "$<${release}:LINKER:--icf=safe>")
            endif ()
        endif ()
    endif ()
    if (ANDROID AND (ANDROID_PLATFORM_LEVEL GREATER_EQUAL 23 OR CMAKE_SYSTEM_VERSION GREATER_EQUAL 23))
        target_link_options(${target_name} PRIVATE "$<${release}:LINKER:--pack-dyn-relocs=android>")
    endif ()
    if (EMSCRIPTEN AND size_option)
        target_link_options(${target_name} PRIVATE "$<${release}:${size_option}>")
    endif ()
endfunction()

function(_huxerui_configure_android_static_target target_name)
    set(shared "$<STREQUAL:$<TARGET_PROPERTY:TYPE>,SHARED_LIBRARY>")
    set(exports "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/HuxerUIAndroid.exports")
    target_link_options(${target_name} INTERFACE
            "$<${shared}:LINKER:--undefined-glob=Java_*>"
            "$<${shared}:LINKER:--undefined-glob=JNI_OnLoad>"
            "$<${shared}:LINKER:--undefined-glob=JNI_OnUnload>"
            "$<${shared}:LINKER:--version-script=${exports}>"
    )
    set_property(TARGET ${target_name} APPEND PROPERTY INTERFACE_LINK_DEPENDS "$<${shared}:${exports}>")
endfunction()
