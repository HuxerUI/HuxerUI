// Everything the application is: its page, its composables, and the
// `Application` object whose constructor registers them.
//
// One include, and it is not HuxerUI's. GCC checks `typeid` per translation
// unit, and UseState(), View and Layout instantiate it in their CALLER, so any
// unit that builds a View needs <typeinfo>. `import huxerui;` cannot supply it
// the way `#include <huxerui/huxerui.h>` does -- a global module fragment's
// includes do not reach an importer -- and huxerui.rules cannot force it
// either, because `-include` prepends before `module;`, which is ill-formed.
//
// Everything else below is the same code a CMake project writes:
// [[huxerui::composable]] means exactly what it means there, and the same hcg
// transforms it.
//
// To hand-write a scope with HUXERUI_SCOPE(...) instead of marking a function,
// add `#include <huxerui_scope_prelude.h>` here -- macros do not cross a
// module boundary, and the rule already puts that header's directory on the
// include path.

module;

#include <typeinfo>

export module app;

import huxerui;

using namespace huxerui;

[[huxerui::composable]]
View Counter() {
  auto count = UseState(0);

  return Row {
    Button("Count").OnClick([count] { count += 1; }),
    Text(count).With(FontSize(24.0F)),
  }.With(Spacing(12.0F), CrossAlign(CrossAxisAlignment::Center));
}

View App() {
  return Column {
    Text("{{project.name}}", TextRole::Title),
    Divider(),
    Counter(),
  }.With(Padding(32.0F), Spacing(16.0F));
}

// Not exported: nothing needs to name it. Its constructor runs at static
// initialisation, which is what registers the application.
const Application application{
    App,
    {.window = {.title = "{{project.name}}", .initial_size = {560.0F, 360.0F}}},
};
