# c++23 is a workaround: mcpp's clang-on-Windows path refuses `import std;`
# below it (mcpp-community/mcpp#603). One standard per module graph, so this
# compiles HuxerUI at c++23 too; back to c++20 once #603 is fixed.
[package]
name     = "{{project.name}}"
version  = "0.1.0"
standard = "c++23"
platforms = ["linux", "windows", "macos", "ios", "android", "emscripten"]

# The exact package identity (namespace included); a bare name searches
# `mcpplibs` only.
[dependencies]
{{self.name}} = "{{self.version}}"

[targets.{{project.name}}]
# `lib`, not `shared`: whether this library is a separate file at run time is
# the consuming program's decision, expressed with `[build] dependency_linkage`.
kind = "lib"

# The module a consumer imports. mcpp's convention is
# `src/<last segment of the package name>.cppm`; a package name may contain
# characters a module name may not, so this file is named for the module it
# declares rather than for the package.
[lib]
path = "src/component.cppm"

[build]
# huxerui.rules selects the sources (build.mcpp); a glob here would compile the
# original beside every hcg-transformed composable.
sources = []

# A library states the exception model it needs on the Web; the application
# that links it is the root that sets it.
[target.'cfg(os = "emscripten")']
requires_abi = { exceptions = true }
