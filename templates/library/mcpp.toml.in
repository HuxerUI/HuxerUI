[package]
name     = "{{project.name}}"
version  = "0.1.0"
standard = "c++20"

# The EXACT package identity, not a bare name: namespace omission means
# `mcpplibs` only, and mcpp's bare-name fallback is deprecated
# ("This fallback is removed in 2026.9"). {{self.name}} renders the selector,
# which carries the namespace.
[dependencies]
{{self.name}} = "{{self.version}}"

[targets.{{project.name}}]
# `lib`, not `shared`: whether this library is a separate file at run time is
# the consuming program's decision, expressed with `[build] dependency_linkage`.
kind = "lib"

# The module a consumer imports. mcpp's convention is
# `src/<last segment of the package name>.cppm`; a package name may contain
# characters a module name may not, so this file is named for the module it
# declares rather than for the package.
[lib]
path = "src/component.cppm"

[build]
# huxerui.rules owns the source selection: a build program can ADD a source but
# cannot replace one, so a package that also globbed src/**/*.cpp would link
# both the original and the transformed copy of every composable.
sources = []
