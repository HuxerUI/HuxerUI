<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application android:name="org.huxerui.examples.SystemTasksApplication">
        <meta-data
            android:name="org.huxerui.local_notification.channel_id"
            android:value="huxerui.system_tasks" />
        <meta-data
            android:name="org.huxerui.local_notification.small_icon"
            android:resource="@drawable/ic_system_task" />
        <service
            android:name="org.huxerui.HuxerUIBackgroundJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name="org.huxerui.HuxerUIForegroundTaskService"
            android:exported="false"
            android:foregroundServiceType="dataSync">
            <meta-data
                android:name="org.huxerui.system_task.identifiers"
                android:value="com.huxerui.examples.systemtasks.export,com.huxerui.examples.systemtasks.receive" />
            <meta-data
                android:name="org.huxerui.system_task.channel"
                android:value="huxerui.system_tasks" />
            <meta-data
                android:name="org.huxerui.system_task.icon"
                android:resource="@drawable/ic_system_task" />
        </service>
    </application>
</manifest>
