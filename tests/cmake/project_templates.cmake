cmake_minimum_required(VERSION 3.20)

foreach (required_variable IN ITEMS CLI_EXECUTABLE SOURCE_DIRECTORY WORK_DIRECTORY HOST_GENERATOR HOST_CXX_COMPILER)
    if (NOT DEFINED ${required_variable})
        message(FATAL_ERROR "${required_variable} is required")
    endif ()
endforeach ()

string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef TEST_NONCE)
set(TEST_ROOT "${WORK_DIRECTORY}/huxerui-project-templates-${TEST_NONCE}")
file(MAKE_DIRECTORY "${TEST_ROOT}")

function(run_checked)
    execute_process(COMMAND ${ARGV} WORKING_DIRECTORY "${TEST_ROOT}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if (NOT result EQUAL 0)
        message(FATAL_ERROR "Template fixture failed: ${ARGV}\n${output}${error}")
    endif ()
endfunction()

run_checked("${CLI_EXECUTABLE}" create app sample --platform macos,web --agent none)
run_checked("${CLI_EXECUTABLE}" create library widgets --platform macos --agent none)

if (CMAKE_HOST_APPLE)
    # Check at the end of project(), before a late fallback can mask incorrect initialization.
    file(WRITE "${TEST_ROOT}/check_deployment.cmake" [=[
if (NOT CMAKE_OSX_DEPLOYMENT_TARGET STREQUAL EXPECTED_DEPLOYMENT_TARGET)
    message(FATAL_ERROR "Deployment target at project(): ${CMAKE_OSX_DEPLOYMENT_TARGET}; expected ${EXPECTED_DEPLOYMENT_TARGET}")
endif ()
]=])
    foreach (project IN ITEMS framework sample widgets widgets/examples/preview)
        if (project STREQUAL "framework")
            set(source "${SOURCE_DIRECTORY}")
            set(project_arguments -DHUXERUI_LIBRARY_GRAPH_ONLY=ON)
        else ()
            set(source "${TEST_ROOT}/${project}")
            set(project_arguments -DHUXERUI_PROJECT_PLAN_ONLY=ON)
        endif ()
        foreach (mode IN ITEMS default explicit environment toolchain cross_toolchain)
            set(build "${TEST_ROOT}/${project}/check-${mode}")
            set(arguments)
            set(environment --unset=MACOSX_DEPLOYMENT_TARGET --unset=CMAKE_TOOLCHAIN_FILE)
            set(expected 12.0)
            if (mode STREQUAL "explicit")
                set(expected 13.0)
                list(APPEND arguments -DCMAKE_OSX_DEPLOYMENT_TARGET=13.0)
            elseif (mode STREQUAL "environment")
                set(expected 14.0)
                list(APPEND environment MACOSX_DEPLOYMENT_TARGET=14.0)
            elseif (mode STREQUAL "toolchain")
                set(expected 13.0)
                file(WRITE "${TEST_ROOT}/native_toolchain.cmake"
                        "set(CMAKE_SYSTEM_NAME Darwin)\n"
                        "set(CMAKE_OSX_DEPLOYMENT_TARGET 13.0 CACHE STRING \"Fixture target\")\n")
                list(APPEND arguments "-DCMAKE_TOOLCHAIN_FILE=${TEST_ROOT}/native_toolchain.cmake")
            elseif (mode STREQUAL "cross_toolchain")
                set(expected 11.0)
                file(WRITE "${TEST_ROOT}/toolchain.cmake"
                        "set(CMAKE_SYSTEM_NAME Generic)\n"
                        "set(CMAKE_OSX_DEPLOYMENT_TARGET 11.0 CACHE STRING \"Fixture target\")\n")
                list(APPEND arguments "-DCMAKE_TOOLCHAIN_FILE=${TEST_ROOT}/toolchain.cmake")
            endif ()
            run_checked("${CMAKE_COMMAND}" -E env ${environment}
                    "${CMAKE_COMMAND}" -S "${source}" -B "${build}"
                    -G "${HOST_GENERATOR}"
                    "-DCMAKE_PROJECT_INCLUDE=${TEST_ROOT}/check_deployment.cmake"
                    "-DEXPECTED_DEPLOYMENT_TARGET=${expected}" ${project_arguments} ${arguments})
            unset(cache_CMAKE_OSX_DEPLOYMENT_TARGET)
            load_cache("${build}" READ_WITH_PREFIX cache_ CMAKE_OSX_DEPLOYMENT_TARGET)
            if (NOT cache_CMAKE_OSX_DEPLOYMENT_TARGET STREQUAL expected)
                message(FATAL_ERROR
                        "${project} ${mode} deployment target: ${cache_CMAKE_OSX_DEPLOYMENT_TARGET}; expected ${expected}")
            endif ()
        endforeach ()
    endforeach ()
endif ()

# Exercise the generated Web shell with a native executable so this dependency
# regression runs on every desktop host without requiring an Emscripten SDK.
set(PROJECT_ROOT "${TEST_ROOT}/sample")
set(BUILD_ROOT "${TEST_ROOT}/web-build")
file(WRITE "${PROJECT_ROOT}/main.cpp" "int main() { return 0; }\n")
file(WRITE "${PROJECT_ROOT}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.20)
project(web_shell LANGUAGES CXX)
add_executable(sample main.cpp)
set_target_properties(sample PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/output/$<CONFIG>")
include(platform/web/huxerui.cmake)
huxerui_configure_web_app(sample)
]=])
run_checked("${CMAKE_COMMAND}" -S "${PROJECT_ROOT}" -B "${BUILD_ROOT}" -G "${HOST_GENERATOR}"
        "-DCMAKE_CXX_COMPILER=${HOST_CXX_COMPILER}" -DCMAKE_BUILD_TYPE=Release)
run_checked("${CMAKE_COMMAND}" --build "${BUILD_ROOT}" --config Release --target sample)
set(OUTPUT_ROOT "${BUILD_ROOT}/output/Release")
file(TIMESTAMP "${OUTPUT_ROOT}/sample.js" original_timestamp "%s.%f")
file(APPEND "${PROJECT_ROOT}/platform/web/index.html.in" "\n<!-- updated shell -->\n")
file(APPEND "${PROJECT_ROOT}/platform/web/favicon.svg" "\n<!-- updated icon -->\n")
file(WRITE "${PROJECT_ROOT}/platform/web/apple-touch-icon.png" "updated icon bytes")
run_checked("${CMAKE_COMMAND}" --build "${BUILD_ROOT}" --config Release --target sample)
file(READ "${OUTPUT_ROOT}/sample.html" html)
if (NOT html MATCHES "updated shell")
    message(FATAL_ERROR "HTML-only edits did not reach the Web output")
endif ()
foreach (icon IN ITEMS favicon.svg apple-touch-icon.png)
    file(SHA256 "${PROJECT_ROOT}/platform/web/${icon}" expected_hash)
    file(SHA256 "${OUTPUT_ROOT}/sample.${icon}" actual_hash)
    if (NOT actual_hash STREQUAL expected_hash)
        message(FATAL_ERROR "Icon edits did not reach the Web output: ${icon}")
    endif ()
endforeach ()
file(TIMESTAMP "${OUTPUT_ROOT}/sample.js" updated_timestamp "%s.%f")
if (NOT updated_timestamp STREQUAL original_timestamp)
    message(FATAL_ERROR "Shell-only edits unnecessarily relinked the executable")
endif ()
file(REMOVE "${OUTPUT_ROOT}/sample.html")
run_checked("${CMAKE_COMMAND}" --build "${BUILD_ROOT}" --config Release --target sample)
if (NOT EXISTS "${OUTPUT_ROOT}/sample.html")
    message(FATAL_ERROR "Build did not restore the deleted Web shell")
endif ()

file(REMOVE_RECURSE "${TEST_ROOT}")
