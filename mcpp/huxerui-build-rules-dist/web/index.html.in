<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{title}}</title>
  <style>
    html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; }
    #huxerui-root { display: block; width: 100%; height: 100%; }
  </style>
</head>
<body>
  <div id="huxerui-root"></div>
  <script type="module">
    // The launcher is the MODULARIZE + EXPORT_ES6 build mcpp.toml's emscripten
    // section links; the storage key scopes the application's browser-managed
    // files to this page. Both come from the target's name.
    import createHuxerUIApp from "./{{name}}.js";

    const module = await createHuxerUIApp({
      huxeruiStorageKey: "{{name}}",
    });
    await document.fonts.ready;
    const session = module.mountHuxerUI("#huxerui-root");
    if (!session) {
      throw new Error("HuxerUI Web session could not be mounted");
    }
  </script>
</body>
</html>
